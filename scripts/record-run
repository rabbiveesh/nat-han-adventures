#!/usr/bin/env bash
# Record a video (with the game's real audio) of a scripted run, without touching your screen
# or speakers: a private Xvfb display, a PulseAudio null sink (removed afterwards), ffmpeg
# capturing both, and a key timeline driven over BRP.
#   scripts/record-run <out.mp4> <key-script> [level-number] [extra cargo args...]
# <key-script> is a bash file run with these helpers in scope:
#   key <keys...> <ms>    hold the keys (BRP names: Space, ArrowRight, KeyR, ...) for <ms>
#   pause <seconds>
# Env: BRP_PORT (default 15881), DISPLAY_NUM (default 97), RECORD_SECS cap (default 120).
set -euo pipefail
out=$(realpath -m "$1"); script=$(realpath "$2"); level=${3:-1}; shift 3 || shift $#
root="$(cd "$(dirname "$0")/.." && pwd)"
port=${BRP_PORT:-15881}; disp=${DISPLAY_NUM:-97}; cap=${RECORD_SECS:-120}
tmp=$(mktemp -d)
cleanup() {
  [[ -n ${ff:-} ]] && kill -INT "$ff" 2>/dev/null && command wait "$ff" 2>/dev/null || true
  [[ -n ${game:-} ]] && kill "$game" 2>/dev/null || true
  [[ -n ${xv:-} ]] && kill "$xv" 2>/dev/null || true
  [[ -n ${sink:-} ]] && pactl unload-module "$sink" 2>/dev/null || true
}
trap cleanup EXIT

(cd "$root" && nice -n 15 cargo build "$@" >/dev/null)
Xvfb ":$disp" -screen 0 1280x720x24 >/dev/null 2>&1 & xv=$!
sink=$(pactl load-module module-null-sink sink_name=nathan_rec sink_properties=device.description=nathan_rec)
sleep 1
(cd "$root" && DISPLAY=":$disp" PULSE_SINK=nathan_rec BRP_EXTRAS_PORT=$port \
  NATHAN_SAVE="$tmp/progress.txt" NATHAN_LEVEL=$level NATHAN_AUDIO=device \
  VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.x86_64.json \
  cargo run "$@" >"$tmp/game.log" 2>&1) & game=$!
until curl -s -o /dev/null -X POST "http://127.0.0.1:$port" -d '{}'; do
  sleep 0.5; kill -0 "$game" 2>/dev/null || { cat "$tmp/game.log" | tail -20; exit 1; }
done
sleep 1
/usr/bin/ffmpeg -hide_banner -loglevel error -y -t "$cap" \
  -f x11grab -framerate 30 -video_size 1280x720 -i ":$disp" \
  -f pulse -i nathan_rec.monitor \
  -c:v libx264 -preset veryfast -crf 23 -pix_fmt yuv420p -c:a aac -b:a 160k "$out" & ff=$!

key() { local ms=${*: -1}; local keys=("${@:1:$#-1}"); local list; list=$(printf '"%s",' "${keys[@]}");
  curl -s -X POST "http://127.0.0.1:$port" -H 'content-type: application/json' \
    -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"brp_extras/send_keys\",\"params\":{\"keys\":[${list%,}],\"duration_ms\":$ms}}" >/dev/null
  sleep "$(echo "$ms/1000" | bc -l)"; }
pause() { sleep "$1"; }
source "$script"
sleep 1
kill -INT "$ff"; wait_pid=$ff; ff=; command wait "$wait_pid" 2>/dev/null || true
echo "recorded $out"
