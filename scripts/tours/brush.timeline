wait 0.1
hold Right 0.1
hold Right Space 100ms
hold Right 0.3
wait 0.1
hold Left 0.1
hold Left Space 100ms
hold Left 0.3
wait 0.1
hold Right 0.05
hold Right Space 100ms
hold Right 0.2
wait 0.1
hold Right 0.8
hold Right Space 300ms
hold Right 0.2
hold Right 0.5
hold Right Space 300ms
wait 0.1
hold Right Space 300ms
hold Right 0.2
hold Right 0.2
hold Right Space 300ms
hold Right 0.3
hold Right 0.5
hold Right Space 300ms
wait 0.1
hold Right Space 300ms
hold Right 0.2
hold Right 3.0
wait 0.2
tap Down
wait 1.0
hold Left 0.15
wait 0.1
hold Right 0.35
hold Right Space 400ms
hold Right 0.1
hold Right Space 250ms
hold Right 0.6
wait 0.5
hold Right 0.6
wait 2
