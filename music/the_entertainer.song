; The Entertainer (Scott Joplin, 1902)
; Converted from src/audio/songs.rs. Each line ends with its bar numbers.

[song]
title = The Entertainer (Scott Joplin, 1902)
bpm = 132
swing = 0.2
key = C
loop = yes
meter = 4/4

[chords]
| C | % | G7 | C | C | C D7 | G D7 | G7 |                    ; 1-8
| C | % | G7 | C C7 | Fmaj7 | F#dim7 | C/G G7 | C |          ; 9-16
| C | % | G7 | C | C | C D7 | G D7 | G7 |                    ; 17-24
| C | % | G7 | C C7 | Fmaj7 | F#dim7 | C/G G7 | C |          ; 25-32

[instruments]
; The band's alternates: each channel's base is `default` (the sound as written); its
; musician may switch to the others for a phrase or a fill. `@i name` uses one in the MML.
pluck    : vol 15 12 9 7 6 5 4 | duty 1                                    ; plucked: a sharp attack, then quiet
musicbox : vol 14 10 7 5 4 3 2 1 | duty 0 | pitch +12 0                   ; a music box: a glassy octave ping
banjo    : vol 15 10 7 5 4 3 2 2 1 | duty 2 1 | pitch +0.25 0                ; a banjo: bright, gone in a flash
thump    : vol 15 11 9 8 7                                                    ; a plucked upright bass
tight    : kick pitch=-30 decay=3 | snare noise=short decay=2 tone=220 | hat decay=0.5 | ohat decay=3 ; a tight, dry kit
pulse1 = default pluck musicbox
pulse2 = default banjo pluck
triangle = default thump
noise = default tight

