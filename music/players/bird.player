; Charlie Parker, 1945-51: 16-note lines over 6.6 beats [3.7-10.0], 1.6 beats' rest
; [1.0-2.7], 16% before the beat; 16ths 21% (and double time), 8ths 26%, triplets 10%; 59%
; steps, 27% thirds; 52% chord tones on the strong beats, 69% of phrases end on one; 36%
; half-step approaches (most from above), 15% enclosures; alto.
; Measured on their transcribed solos in the Weimar Jazz Database v2.1: statistics only, never
; their phrases. The format is documented in `src/audio/live/player_file.rs`.

[player]
name = Bird
lay_back = 0.9              ; +2.4 ms
swing = 1.60                ; long 8th over short (2.0: a full triplet)
legato = 0.92               ; sounding length against the time to the next note
register = 70 62 82         ; MIDI, the lead's octave: centre, soft floor, soft ceiling

[line]
phrase = 6.6 3.7 10.0       ; beats: median, lower and upper quartile (log-normal)
rest = 1.6 1.0 2.7          ; the rest between phrases, likewise
cells = eighths 12.9, quarter 2.2, triplet 3.5, sixteenths 7.0, dotted 3.6, quarter_triplet 1.3, long 0.9
intervals = 2.3 30.3 28.8 19.0 8.1 4.9 1.0 2.0 3.6 ; by size: 0 1 2 3 4 5 6 7 8-12 semitones
step_back = 0.34            ; after a leap (5 or more), a step back the other way
end_chord_tone = 0.69       ; a phrase's last note on a chord tone
approach = 0.22             ; a half step into a strong-beat chord tone...
from_below = 0.40           ; ...from below this share of the time
enclosure = 0.13            ; one above and one below into a strong-beat chord tone
pentatonic = 0.05           ; a run of four through the chord's pentatonic
anticipation = 0.16         ; a phrase starts on the "and" before the bar line
falls = 0.05                ; a fall off a phrase's last note

[dynamics]
; Decaying lines: loud in, falling all the way to a soft last note (−3.7 dB); offbeats ghosted 31% of the time; long notes much softer; 5.3 dB.
arch = 1.28 1.12 0.07 -0.70 -3.68 ; dB: first note, early, middle, late, last note
per_octave = 4.5            ; dB per octave above the register's centre
ghost = 0.31                ; the offbeat 8th ghosted (-4 dB) this often...
accent = 0.27               ; ...or else accented this much (dB)
long = -4.0                 ; notes of 1.2 beats or more (dB)
scatter = 3.8               ; each note's own spread (dB, a standard deviation)

[motifs]
; The least motivic (a vocabulary, not development); his sequences step down.
motif = 0.05                ; a phrase restates the last one's head, then goes its own way
sequence = 0.03             ; a 3-4 note cell restated straight after (a sequence)
moves = -2:3.6 0:1.4 -3:1.4 -5:0.7 -7:0.7 ; the sequences' transpositions (semitones:weight)
