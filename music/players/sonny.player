; Sonny Rollins, 1954-72: 11.5-note lines over 6.6 beats [3.9-13.3], 2.4 beats' rest
; [1.5-3.4]; 8ths 46% (the longest 8th runs of anyone, 10 notes at p90), 16ths 14%;
; 50% steps, 31% thirds, 15% leaps; 56% chord tones on the strong beats, 62% of phrases end
; on one; 28% half-step approaches (either side), 14% enclosures; low on the tenor.
; Measured on their transcribed solos in the Weimar Jazz Database v2.1: statistics only, never
; their phrases. The format is documented in `src/audio/live/player_file.rs`.

[player]
name = Sonny
lay_back = 2.2              ; +6.2 ms
swing = 1.50                ; long 8th over short (2.0: a full triplet)
legato = 0.88               ; sounding length against the time to the next note
register = 64 55 77         ; MIDI, the lead's octave: centre, soft floor, soft ceiling

[line]
phrase = 6.6 3.9 13.3       ; beats: median, lower and upper quartile (log-normal)
rest = 2.4 1.5 3.4          ; the rest between phrases, likewise
cells = eighths 22.8, quarter 7.8, triplet 3.4, sixteenths 3.0, dotted 4.8, quarter_triplet 1.4, long 2.0
intervals = 3.8 23.3 26.1 21.0 10.3 7.9 1.8 2.8 2.6 ; by size: 0 1 2 3 4 5 6 7 8-12 semitones
step_back = 0.19            ; after a leap (5 or more), a step back the other way
end_chord_tone = 0.62       ; a phrase's last note on a chord tone
approach = 0.18             ; a half step into a strong-beat chord tone...
from_below = 0.51           ; ...from below this share of the time
enclosure = 0.11            ; one above and one below into a strong-beat chord tone
pentatonic = 0.08           ; a run of four through the chord's pentatonic
anticipation = 0.11         ; a phrase starts on the "and" before the bar line
falls = 0.1                 ; a fall off a phrase's last note

[dynamics]
; A mild arch with a soft last note (−1.7), the top note +1.5 dB, offbeats ghosted 21%.
arch = 0.36 0.39 -0.03 -0.10 -1.66 ; dB: first note, early, middle, late, last note
per_octave = 2.0            ; dB per octave above the register's centre
ghost = 0.21                ; the offbeat 8th ghosted (-4 dB) this often...
accent = 0.45               ; ...or else accented this much (dB)
long = -1.1                 ; notes of 1.2 beats or more (dB)
scatter = 3.2               ; each note's own spread (dB, a standard deviation)

[motifs]
; A motif developer: cells shared phrase to phrase at 1.9x chance, short-phrase relations 17% (1-5% by chance).
motif = 0.25                ; a phrase restates the last one's head, then goes its own way
sequence = 0.05             ; a 3-4 note cell restated straight after (a sequence)
moves = 0:4.8 -2:1.4 -3:1.0 -1:0.8 5:0.6 ; the sequences' transpositions (semitones:weight)

[licks]
; Ours, written to rhyme with his shapes (arpeggios through the b9, neighbour-note figures
; on the major chord, blues riffs on the root and b7), on the beat, 8ths.
rate = 0.25                 ; a phrase opens with one this often (when one fits the chord)
dom = o4 g8 b-8 o5 d-8 o4 b-8 a4
maj = o4 a8 b8 a8 g8 e4
dom = o4 g8 f8 e8 c8 d8 e8 g4
dom = o4 c8 o3 b-8 g8 b-8 o4 c4
min = o4 f8 e-8 c8 e-8 f8 g4
maj = o4 e8 g8 a8 o5 c8 o4 a8 g4
dom = o4 e-8 e8 g8 a8 g8 e8 c4
maj = o4 g4 g8 a8 g4 e4
