; Miles Davis, 1951-59: 8.5-note phrases over 6.1 beats [3.9-10.2], 3.3 beats' rest
; [2.0-4.9]; 8ths 40%, quarters 11%, longer 12%; 9% repeats, 62% steps, 7.6% leaps; 58%
; chord tones on the strong beats, 70% of phrases end on one; 34% half-step approaches (2 in
; 3 from below), 12% enclosures; trumpet around concert A4-Bb4.
; Measured on their transcribed solos in the Weimar Jazz Database v2.1: statistics only, never
; their phrases. The format is documented in `src/audio/live/player_file.rs`.

[player]
name = Miles '56
lay_back = 1.6              ; on-beat notes +4.6 ms behind (the average soloist: +2.8)
swing = 1.36                ; long 8th over short (2.0: a full triplet)
legato = 0.88               ; sounding length against the time to the next note
register = 72 64 82         ; MIDI, the lead's octave: centre, soft floor, soft ceiling

[line]
phrase = 6.1 3.9 10.2       ; beats: median, lower and upper quartile (log-normal)
rest = 3.3 2.0 4.9          ; the rest between phrases, likewise
cells = eighths 19.8, quarter 11.2, triplet 2.7, sixteenths 2.0, dotted 5.7, quarter_triplet 1.9, long 5.9
intervals = 9.4 28.0 33.5 13.1 8.4 3.8 0.7 1.8 1.3 ; by size: 0 1 2 3 4 5 6 7 8-12 semitones
step_back = 0.24            ; after a leap (5 or more), a step back the other way
end_chord_tone = 0.70       ; a phrase's last note on a chord tone
approach = 0.24             ; a half step into a strong-beat chord tone...
from_below = 0.69           ; ...from below this share of the time
enclosure = 0.10            ; one above and one below into a strong-beat chord tone
pentatonic = 0.05           ; a run of four through the chord's pentatonic
anticipation = 0.10         ; a phrase starts on the "and" before the bar line
falls = 0.25                ; a fall off a phrase's last note

[dynamics]
; Shapes the most: a soft first note, louder early, fading out; the top note +4.4 dB; the "and" louder than its beat 55% of the time (19% ghosted); spread 5.0 dB.
arch = -1.46 1.06 0.58 -0.83 -1.31 ; dB: first note, early, middle, late, last note
per_octave = 4.5            ; dB per octave above the register's centre
ghost = 0.19                ; the offbeat 8th ghosted (-4 dB) this often...
accent = 1.66               ; ...or else accented this much (dB)
long = -1.0                 ; notes of 1.2 beats or more (dB)
scatter = 3.0               ; each note's own spread (dB, a standard deviation)

[motifs]
motif = 0.15                ; a phrase restates the last one's head, then goes its own way
sequence = 0.04             ; a 3-4 note cell restated straight after (a sequence)
moves = 0:7.7 -2:0.8 -3:0.8 -1:0.5 2:0.3 ; the sequences' transpositions (semitones:weight)

[licks]
; Ours, written to rhyme with his commonest shapes (statistics in the lick report: scale
; fragments up from the root and down from the 13th, the chromatic upper-neighbour turn,
; half steps from below); 5-8 notes, mostly 8ths, with room around them.
rate = 0.2                  ; a phrase opens with one this often (when one fits the chord)
maj = o4 e8 f8 g8 a8 g4
dom = o4 a4 g8 e8 f8 d8 e4
min = o4 d8 e-8 f8 g8 b-4. a8
any = o4 g8 a-8 g8 f8 e4
dom = o4 b-8 a8 a-8 g4
maj = o4 b8 o5 c8 d8 e4 d8 c8
min = o4 g8 f8 e-8 d8 c4
dom = o4 e8 g8 a8 g8 e4 c4
