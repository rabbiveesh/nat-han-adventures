; Funk: the soloists over a funk feel in the Weimar Jazz Database (20 solos, 1969-2000s:
; Miles on Bitches Brew, Sonny, Steve Coleman, Kenny Garrett, Bob Berg, Joshua Redman,
; Chris Potter; 84-159 bpm). Short phrases (5 beats) with short breaths, half the notes
; 16ths, steps and half steps, a third of 4-note windows pentatonic, chromatic runs into the
; chord tones; well behind the beat (+18 ms, +26 below 100 bpm). Not one player: what the
; funk feel's players share. Played in the band's funk sections.
; Measured on their transcribed solos: statistics only, never their phrases. The format is
; documented in `src/audio/live/player_file.rs`.

[player]
name = Funk
lay_back = 2.8              ; +18 ms on the beat (the swing players: +5-8 in the same window)
swing = 1.22                ; nearly straight 8ths (their 16ths: 1.25 from the "e")
legato = 0.84               ; sounding length against the time to the next note
register = 67 57 79         ; MIDI, the lead's octave: centre, soft floor, soft ceiling

[line]
phrase = 5.1 2.9 7.9        ; beats: median, lower and upper quartile (log-normal)
rest = 1.3 0.9 2.4          ; the rest between phrases, likewise
cells = eighths 11.4, quarter 4.5, triplet 4.0, sixteenths 12.9, dotted 2.2, quarter_triplet 0.7, long 3.0
intervals = 7.5 27.0 28.3 15.9 7.3 7.4 1.5 2.5 2.6 ; by size: 0 1 2 3 4 5 6 7 8-12 semitones
step_back = 0.25            ; after a leap (5 or more), a step back the other way
end_chord_tone = 0.64       ; a phrase's last note on a chord tone
approach = 0.24             ; a half step into a strong-beat chord tone...
from_below = 0.51           ; ...from below this share of the time
enclosure = 0.07            ; one above and one below into a strong-beat chord tone
pentatonic = 0.37           ; a run of four through the chord's pentatonic
anticipation = 0.27         ; a phrase starts on the "and" before the bar line
falls = 0.04                ; a fall (or a bend, a slide) off a phrase's last note

[dynamics]
; Nearly even, then fading over the phrase's last notes; hardly louder going up; 5.4 dB scatter.
arch = -0.66 -0.15 -0.33 -1.01 -2.32 ; dB: first note, early, middle, late, last note
per_octave = 0.45           ; dB per octave above the register's centre
ghost = 0.2                 ; the offbeat 8th ghosted (-4 dB) this often...
accent = 0.8                ; ...or else accented this much (dB)
long = -2.0                 ; notes of 1.2 beats or more (dB)
scatter = 4.0               ; each note's own spread (dB, a standard deviation)

[motifs]
motif = 0.1                 ; a phrase restates the last one's head, then goes its own way
sequence = 0.05             ; a 3-4 note cell restated straight after (a sequence)
moves = -5:8 4:5 -3:2 -2:2 1:2 ; the sequences' transpositions (semitones:weight)

[licks]
; Ours, written to rhyme with the shapes the funk solos share (chromatic runs down from the
; 5th, the root's upper neighbour, minor pentatonic cells from the 4th and the 5th, a
; chromatic rise to the 5th, the outside rise resolving down), in 16ths.
rate = 0.25                 ; a phrase opens with one this often (when one fits the chord)
any = o4 g16 g-16 f16 e16 c8
dom = o5 c16 d-16 c16 o4 b16 b-8 g8
min = o4 f16 e-16 c16 o3 b-16 o4 c8 e-16 f16
min = o4 e-16 e16 f16 e16 e-16 c8
dom = o4 f16 g-16 g16 a-16 g8 e-16 c16
maj = o4 g16 a-16 g-16 g16 e16 d16 c8
min = o3 g16 b-16 o4 c16 d16 f16 d16 c16 o3 b-16
min = o4 g-16 a-16 b-16 o5 d-16 c8 o4 b-16 g16
