; Embraceable You (George & Ira Gershwin, 1930)
; Side B's opener: the ballad as a two-beat stomp, the clarinet out front. Melody and changes
; from Veesh's chart (an octave up). Each line ends with its bar numbers.
; bpm: Side B's levels are timed to Tiger Rag's tempo, so its tunes keep it.

[song]
title = Embraceable You (George Gershwin, 1930)
bpm = 192
swing = 0.33
key = G
loop = yes
meter = 4/4

[chords]
| G6 | Bbdim7 | Am7 | D7 | Am7 | Cm6 F7 | G6 | F#m7b5 B7 | ; 1-8
| Em7 Em/D | C#m7b5 F#7 | Bm7 | Em7 A7 | Dmaj7 Ebdim7 | Em7 A7 | Am7 | D7 | ; 9-16
| G6 | Bbdim7 | Am7 | D7 | Am7 | Cm6 F7 | G6 | Dm7 G7 | ; 17-24
| Cmaj7 | F#m7b5 B7 | Em7 | A7 A#dim7 | Bm7 E7 | Am7b5 D7 | G6 Em7 | Am7 D7 | ; 25-32

[instruments]
; The band's alternates: each channel's base is `default` (the sound as written); its
; musician may switch to the others for a phrase or a fill. `@i name` uses one in the MML.
brass    : vol 9 12 14 15 15 14 13 | duty 0 1 2 | pitch -1 -0.5 -0.25 0 | vib delay=14 depth=14 speed=5.5   ; a trumpet: swell, scoop, late vibrato
clarinet : vol 10 12 13 | duty 1 | vib delay=10 depth=18 speed=5                ; woody, narrow, a warm vibrato
banjo    : vol 15 10 7 5 4 3 2 2 1 | duty 2 1 | pitch +0.25 0                ; a banjo: bright, gone in a flash
tuba     : vol 15 13 12 11 | pitch -0.5 0                                     ; an oom-pah tuba (on the triangle)
brushes  : kick decay=3 click=0.1 | snare decay=6 period=6 tone=150 body=1 | hat decay=0.6 period=3 ; brushes
pulse1 = default brass clarinet
pulse2 = default banjo
triangle = default tuba
noise = default brushes
; The feels' instruments (a feel and channel not listed plays the built-in set):
bossa.pulse1 = clarinet
samba.pulse1 = brass
samba.pulse2 = banjo

